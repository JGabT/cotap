{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cotap",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cotap-db",
      "database_id": "5199b309-1596-4a4d-81ce-f510a74cdd52"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CACHE",
      "bucket_name": "cotap-cache"
    }
  ],
  "observability": {
    "enabled": true
  }
}
